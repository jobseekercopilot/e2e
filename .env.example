E2E_BASE_URL=http://localhost:3100
E2E_PROFILE=demo
BASE_URL=http://localhost:3100
AUTHENTICATION_FIXTURE_URL=http://localhost:9104
# Use local-ses only with the Infrastructure LocalStack overlay.
ACCOUNT_EMAIL_E2E_MODE=fixture
LOCALSTACK_SES_URL=http://127.0.0.1:4566
# ENVIRONMENT_DATA_TOKEN is a runtime-only guard shared with the test-stack authentication service.
ENVIRONMENT_DATA_TOKEN=
SYSTEM_DATA_SERVICE_URL=http://localhost:9103
SYSTEM_DATA_TIMEOUT_MS=10000
# SYSTEM_DATA_INTERNAL_CALLER_KEY is a runtime-only value of at least 32 characters.
SYSTEM_DATA_INTERNAL_CALLER_KEY=
FIXTURE_DATASET_ID=uk-software-developer-demo
FIXTURE_DATASET_VERSION=1.0.0
FIXTURE_SCENARIO=DEMO_READY
HEADLESS=false
SLOW_MO=150
RECORD_VIDEO=true
VIDEO_DIR=videos
DEMO_MODE=true
USE_SAVED_SESSION=false
SAVE_DEMO_SESSION=false
STORAGE_STATE=.auth/alex-taylor-session.json
ARTIFACT_DIR=test-results/failures
MAX_FAILURE_ARTIFACTS=20
CAPACITY_RESULT_DIR=test-results/capacity/workers
CAPACITY_FIXTURE_CONFIRMED=false
E2E_CLEANUP_ENABLED=false
E2E_CLEANUP_BASE_URL=http://localhost:8080
# E2E_CLEANUP_TOKEN is supplied only by the local test-stack environment.
# Real provider calls are restricted to the bounded live stabilisation runners.
ALLOW_REAL_PROVIDER_E2E=false
ALLOW_AI_GENERATION=false
# The one-call diagnostic probe requires this additional explicit gate.
ALLOW_SINGLE_GENERATION_PROBE=false
# Cancellation can consume a live generation before the cancellation is observed.
ALLOW_CANCELLATION_E2E=false
# Preserve is accepted only by the explicitly authorised five-generation checkpoint.
PRESERVE_DEMO_READY_AFTER_RUN=false
ALLOW_RESTORED_PERSISTENCE_SMOKE=false
RESTORED_RUNTIME_CONFIRMED=false
STABILISATION_ARTIFACT_DIR=test-results/stabilisation
STABILISATION_MANIFEST=test-results/stabilisation/preserved-live-manifest.json
TYPING_DELAY_MS=65
DEMO_BUFFER_MS=2000
DEMO_SCROLL_MS=650
VIDEO_NAME=registration-demo
